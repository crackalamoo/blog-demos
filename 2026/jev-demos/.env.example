TYPESAFE_API_KEY=your_typesafe_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides read by typesafe-sdk (defaults shown)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=

# Optional.  A Wikimedia OAuth 2.0 owner-only access token, used by the
# wiki demo for the MediaWiki compare API.  Without it Wikipedia throttles
# those requests hard and the demo judges only a fraction of the edits it
# sees.  Make one at:
#   https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
# WIKIMEDIA_TOKEN=your_wikimedia_access_token_here
